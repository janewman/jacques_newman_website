<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "Jacques Newman" }}</title>
    <meta name="description" content="{{ description or 'Personal website' }}" />
    <script type="module" src="/assets/main.js"></script>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.5;
        color: #172033;
        background: #f7f8fb;
      }

      body {
        margin: 0;
        min-width: 20rem;
      }

      main {
        max-width: 76rem;
        margin: 0 auto;
        padding: 2rem;
      }

      a {
        color: #075ea8;
        text-underline-offset: 0.16em;
      }

      a:hover {
        text-decoration-thickness: 0.14em;
      }

      a:focus-visible {
        border-radius: 0.15rem;
        outline: 0.2rem solid #f3b61f;
        outline-offset: 0.2rem;
      }

      @media (max-width: 40rem) {
        main {
          padding: 1.25rem;
        }
      }
    </style>
    {% if stylesheet %}
      <link rel="stylesheet" href="{{ stylesheet }}" />
    {% endif %}
  </head>
  <body class="{{ bodyClass or '' }}">
    <site-header name="Jacques Newman"></site-header>
    <main>{{ content | safe }}</main>
  </body>
</html>
