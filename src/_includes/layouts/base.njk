<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "Jacques Newman" }}</title>
    <meta name="description" content="{{ description or 'Personal website' }}" />
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.5;
        color: #172033;
        background: #f7f8fb;
      }

      body {
        margin: 0;
        min-width: 20rem;
      }

      main {
        max-width: 76rem;
        margin: 0 auto;
        padding: 2rem;
      }

      a {
        color: #075ea8;
        text-underline-offset: 0.16em;
      }

      a:hover {
        text-decoration-thickness: 0.14em;
      }

      a:focus-visible {
        border-radius: 0.15rem;
        outline: 0.2rem solid #f3b61f;
        outline-offset: 0.2rem;
      }

      site-header {
        display: block;
      }

      .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 76rem;
        margin: 0 auto;
        padding: 1rem 2rem;
      }

      .site-header__name {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
      }

      .site-header__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .site-header__nav a {
        color: inherit;
        text-underline-offset: 0.2em;
      }

      @media (max-width: 40rem) {
        .site-header__inner {
          padding-inline: 1.25rem;
        }

        main {
          padding: 1.25rem;
        }
      }
    </style>
    {% if stylesheet %}
      <link rel="stylesheet" href="{{ stylesheet }}" />
    {% endif %}
  </head>
  <body class="{{ bodyClass or '' }}">
    {% include "site-header.njk" %}
    <main>{{ content | safe }}</main>
  </body>
</html>
